# Safe default for offline development and tests.
LEAD_SCOUT_PROVIDER=mock

# Required only when LEAD_SCOUT_PROVIDER=google. Keep this server-side.
GOOGLE_PLACES_API_KEY=

# Server-only CRM integration. LEAD_SCOUT_API_TOKEN must match the backend.
SENTRYPOINT_API_BASE_URL=http://localhost:8081
SENTRYPOINT_CRM_BASE_URL=http://localhost:3000
LEAD_SCOUT_API_TOKEN=
